# Database (PostgreSQL - Required for Vercel)
# Get a free PostgreSQL database from: https://neon.tech, https://supabase.com, or https://planetscale.com
#
# For Neon, you'll have two connection types:
# DATABASE_URL (pooled - has "-pooler" in hostname) - Use for app queries in serverless
# DIRECT_DATABASE_URL (direct - no "-pooler" in hostname) - Use for migrations
#
# Example:
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require"
# DIRECT_DATABASE_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require"

DATABASE_URL="postgresql://user:password@host:5432/young_inventors_lab?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/young_inventors_lab"

# OpenAI API (Required for AI Mentor functionality)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-openai-api-key-here"

# NextAuth.js (Required for authentication)
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here-change-this"
NEXTAUTH_URL="http://localhost:3000"

# Application Settings
NODE_ENV="development"
